# SRC framework environment variables.
# Copy to `.env` and fill in.

# ---- Teacher model (for branch review & correction) ----
TEACHER_API_KEY=
TEACHER_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
TEACHER_MODEL=qwen-plus

# ---- Student model (Qwen-based VLM, vLLM/OpenAI-compatible) ----
QWEN_BASE_URL=http://localhost:8000/v1
QWEN_MODEL=qwen3.5-9b-sft

# ---- Vision agent API keys (optional, for baseline evaluation) ----
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
